# [마이] 런타임 설정 — mai.env 로 복사해서 사용
# cp mai/config/mai.env.example mai/config/mai.env

# ── 위치 ────────────────────────────────────────────
# 내장 SSD 상주
MAI_HOME="$HOME/MAI"
# 외장 SSD 상주 시 (포터블)
# MAI_HOME="/Volumes/PORTABLE/MAI"

# ── 런타임 ──────────────────────────────────────────
# ollama | mlx | llamacpp
MAI_RUNTIME="ollama"
MAI_HOST="127.0.0.1"      # 절대 0.0.0.0 으로 바꾸지 말 것
MAI_PORT="11434"

# ── 모델 ────────────────────────────────────────────
MAI_MODEL_ID="qwen3:8b"   # docs/MODEL-NOTES.md 참고
MAI_MODEL_FILE=""         # GGUF 직접 지정 시 파일명
MAI_CTX="8192"
MAI_TEMP="0.7"

# ── 상주 정책 ───────────────────────────────────────
MAI_KEEP_ALIVE="30m"      # 유휴 시 모델 언로드까지의 시간
MAI_IDLE_UNLOAD="300"     # 배터리 모드 유휴 언로드(초), 0=비활성

# ── 인격 ────────────────────────────────────────────
MAI_NAME="마이"
MAI_SYSTEM_PROMPT="prompts/system.md"

# ── 2대 병행 운영 (docs/TWO-MACHINE.md) ─────────────
# 이 기기의 역할: primary(대형 모델 호스팅) | mobile(로컬 8B 전용)
MAI_ROLE="mobile"

# 대형 모델을 돌리는 기기의 Tailscale 주소. 비우면 원격 폴백 비활성화.
# 예: https://macmini.tailnet-XXXX.ts.net:8443
MAI_REMOTE_URL=""
MAI_REMOTE_MODEL="qwen3:30b-a3b"

# 원격 응답이 이 시간(초) 안에 없으면 로컬 8B로 폴백
MAI_REMOTE_TIMEOUT="3"

# 저널 파일명에 붙는 호스트 식별자 (비우면 LocalHostName 자동 사용)
MAI_HOST_ID=""

# 기억 private 저장소 경로 (scripts/sync-memory.sh 가 사용)
MAI_MEMORY_REPO="$HOME/MAI/memory"
