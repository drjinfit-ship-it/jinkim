# [마이] 런타임 설정 — mai.env 로 복사해서 사용
# cp mai/config/mai.env.example mai/config/mai.env

# ── 위치 ────────────────────────────────────────────
# 내장 SSD 상주
MAI_HOME="$HOME/MAI"
# 외장 SSD 상주 시 (포터블)
# MAI_HOME="/Volumes/PORTABLE/MAI"

# ── 런타임 ──────────────────────────────────────────
# ollama | mlx | llamacpp
MAI_RUNTIME="mlx"         # Apple Silicon 권장
MAI_HOST="127.0.0.1"      # 절대 0.0.0.0 으로 바꾸지 말 것
MAI_PORT="11434"

# ── 모델 ────────────────────────────────────────────
MAI_MODEL_ID="qwen3-27b-abliterated-mlx"   # docs/MODEL-NOTES.md 참고
MAI_MODEL_FILE=""         # GGUF 직접 지정 시 파일명
MAI_CTX="8192"
MAI_TEMP="0.7"

# ── 상주 정책 ───────────────────────────────────────
MAI_KEEP_ALIVE="30m"      # 유휴 시 모델 언로드까지의 시간
MAI_IDLE_UNLOAD="300"     # 배터리 모드 유휴 언로드(초), 0=비활성

# ── 인격 ────────────────────────────────────────────
MAI_NAME="마이"
MAI_SYSTEM_PROMPT="prompts/system.md"

# ── 플릿 운영 (docs/FLEET.md) ───────────────────────
# 이 기기의 계층: t0(MacBook) | t1(Mac Studio) | t2(GPU 스테이션)
MAI_TIER="t0"

# LiteLLM 라우터 주소. 여기로 보내면 계층별 폴백이 자동 적용됩니다.
# 비우면 라우터를 거치지 않고 로컬 모델만 사용합니다.
# 예: http://macstudio.tailnet-XXXX.ts.net:4000/v1
MAI_ROUTER_URL=""

# 라우터의 모델 별칭 (config/litellm.yaml 참조)
MAI_ROUTER_MODEL="mai"      # mai | mai-big | mai-batch | mai-mobile

# 라우터 응답이 이 시간(초) 안에 없으면 로컬 모델로 폴백
MAI_REMOTE_TIMEOUT="3"

# 저널 파일명에 붙는 호스트 식별자 (비우면 LocalHostName 자동 사용)
MAI_HOST_ID=""

# 기억 private 저장소 경로 (scripts/sync-memory.sh 가 사용)
MAI_MEMORY_REPO="$HOME/MAI/memory"
