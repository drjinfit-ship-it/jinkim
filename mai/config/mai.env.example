# [마이] 런타임 설정 — mai.env 로 복사해서 사용
# cp mai/config/mai.env.example mai/config/mai.env

# ── 위치 ────────────────────────────────────────────
# 내장 SSD 상주
MAI_HOME="$HOME/MAI"
# 외장 SSD 상주 시 (포터블)
# MAI_HOME="/Volumes/PORTABLE/MAI"

# ── 런타임 ──────────────────────────────────────────
# ollama | mlx | llamacpp
MAI_RUNTIME="ollama"
MAI_HOST="127.0.0.1"      # 절대 0.0.0.0 으로 바꾸지 말 것
MAI_PORT="11434"

# ── 모델 ────────────────────────────────────────────
MAI_MODEL_ID="qwen3:8b"   # docs/MODEL-NOTES.md 참고
MAI_MODEL_FILE=""         # GGUF 직접 지정 시 파일명
MAI_CTX="8192"
MAI_TEMP="0.7"

# ── 상주 정책 ───────────────────────────────────────
MAI_KEEP_ALIVE="30m"      # 유휴 시 모델 언로드까지의 시간
MAI_IDLE_UNLOAD="300"     # 배터리 모드 유휴 언로드(초), 0=비활성

# ── 인격 ────────────────────────────────────────────
MAI_NAME="마이"
MAI_SYSTEM_PROMPT="prompts/system.md"
